{
  "expo": {
    "name": "La Mies",
    "slug": "la-mies",
    "version": "0.7.0",
    "orientation": "default",
    "scheme": "lamies",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F6B45"
    },
    "ios": {
      "bundleIdentifier": "com.hopeforargentina.lamies",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "La Mies usa tu ubicación para marcar las calles que recorrés durante una salida de evangelismo.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Para que el recorrido no se corte cuando bloqueás el teléfono, La Mies necesita la ubicación también en segundo plano, solo mientras una salida está activa.",
        "NSFaceIDUsageDescription": "La Mies usa Face ID para desbloquear la app.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hopeforargentina.lamies",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6B45"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Para que el recorrido no se corte cuando bloqueás el teléfono, La Mies necesita la ubicación también en segundo plano, solo mientras una salida está activa.",
          "locationWhenInUsePermission": "La Mies usa tu ubicación para marcar las calles que recorrés durante una salida de evangelismo.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "La Mies usa Face ID para desbloquear la app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La Mies usa tus fotos para poner la foto de cada persona.",
          "cameraPermission": "La Mies usa la cámara para sacar la foto de cada persona.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6B45"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1F6B45"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/la-mies"
    },
    "extra": {
      "supabaseUrl": "https://kntylzdronpglqqgroqv.supabase.co",
      "supabaseAnonKey": "sb_publishable_81akQST1pxlBbECLsn1vSg_ipsZgl0c",
      "eas": {
        "projectId": "e56b4a45-747b-4dfa-8424-ed0b9c479a58"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "La Mies",
      "shortName": "La Mies",
      "lang": "es",
      "backgroundColor": "#FFFFFF",
      "themeColor": "#1F6B45"
    },
    "owner": "hopeforargentinas-team",
    "updates": {
      "url": "https://u.expo.dev/e56b4a45-747b-4dfa-8424-ed0b9c479a58"
    }
  }
}
